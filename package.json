{
  "name": "blog",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "predeploy": "bun run check && bun run typecheck",
    "fix": "ultracite fix",
    "check": "bunx ultracite check && CI=1 bunx react-doctor --yes --verbose --lint --scope full && tsc --noEmit && knip",
    "test": "bun test src/lib",
    "build:cf": "CI=1 bunx react-doctor --yes --verbose --lint --scope full && bun run test && astro build",
    "build:cf:production": "bun run build:cf",
    "deploy:cf": "npx wrangler deploy",
    "version:cf": "npx wrangler preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@directus/sdk": "^27.1.0",
    "@mux/mux-player": "^3.14.1",
    "@mux/mux-player-react": "^3.14.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "loops": "^7.5.0",
    "mdastic": "^0.5.1",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-tweet": "^3.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "safe-mdx": "^2.1.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "portless": "^0.17.0",
    "postcss": "^8.5.32",
    "react-doctor": "0.9.22",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "ultracite": "8.2.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "undici": "^7.24.0",
    "vite": "^8.0.13"
  },
  "packageManager": "bun@1.4.4"
}
