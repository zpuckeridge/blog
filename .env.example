# SPOTIFY TRACKING
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=

# GENERAL
# Canonical site URL for sitemap, robots, RSS (include https://)
PUBLIC_SITE_URL=https://zacchary.me

# GITHUB TOKEN
GITHUB_TOKEN=

# LOOPS
LOOPS_API_KEY=

# VIDEO PASSWORD (also set as a Worker secret in prod: wrangler secret put VIDEO_PASSWORD)
# For `astro dev` / `wrangler dev`, use .dev.vars (same KEY=value as below; file is gitignored).
VIDEO_PASSWORD=

# LOCATION STATUS (iOS Shortcuts webhook — prod: wrangler secret put LOCATION_WEBHOOK_SECRET)
LOCATION_WEBHOOK_SECRET=

# DIRECTUS
DIRECTUS_URL=
DIRECTUS_TOKEN=

# POSTHOG (client) — production must set both (CI / Worker public vars at build time).
# Do not commit real values. Never log PUBLIC_POSTHOG_KEY.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
