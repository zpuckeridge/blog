# SPOTIFY TRACKING
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=

# GENERAL
# Canonical site URL for sitemap, robots, RSS (include https://)
PUBLIC_SITE_URL=https://zacchary.me

# GITHUB TOKEN
GITHUB_TOKEN=

# LOOPS
LOOPS_API_KEY=

# VIDEO PASSWORD (also set as a Worker secret in prod: wrangler secret put VIDEO_PASSWORD)
# For `astro dev` / `wrangler dev`, use .dev.vars (same KEY=value as below; file is gitignored).
VIDEO_PASSWORD=

# LOCATION STATUS (iOS Shortcuts webhook — prod: wrangler secret put LOCATION_WEBHOOK_SECRET)
LOCATION_WEBHOOK_SECRET=

# RHYTHMS (prod: wrangler secret put RHYTHMS_WEBHOOK_SECRET)
RHYTHMS_WEBHOOK_SECRET=

# APPLE MUSIC SUPPLEMENT (prod: wrangler secret put for each)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_CONNECT_SECRET=
# Optional local Music User Token; production uses KV via /music/connect
APPLE_MUSIC_USER_TOKEN=

# DIRECTUS
DIRECTUS_URL=
DIRECTUS_TOKEN=
