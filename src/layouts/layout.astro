---
import "@/styles/globals.css";

import Navigation from "@/components/navigation";
import PostHogClient from "@/components/posthog-client";
import BaseHead from "@/components/seo/base-head.astro";
import JsonLd from "@/components/seo/json-ld.astro";
import type { PageMetadata } from "@/lib/metadata";
import { resolvePosthogClientConfig } from "@/lib/posthog-config";
import { workersEnv } from "@/lib/workers-env";

interface Props {
  canonicalUrl?: string;
  fullTitle: string;
  meta?: PageMetadata;
  rootDefaults?: boolean;
}

const { canonicalUrl, fullTitle, meta, rootDefaults = false } = Astro.props;

const posthog = resolvePosthogClientConfig({
  NEXT_PUBLIC_POSTHOG_HOST:
    import.meta.env.NEXT_PUBLIC_POSTHOG_HOST ??
    workersEnv.NEXT_PUBLIC_POSTHOG_HOST,
  NEXT_PUBLIC_POSTHOG_KEY:
    import.meta.env.NEXT_PUBLIC_POSTHOG_KEY ??
    workersEnv.NEXT_PUBLIC_POSTHOG_KEY,
  PUBLIC_POSTHOG_HOST:
    import.meta.env.PUBLIC_POSTHOG_HOST ?? workersEnv.PUBLIC_POSTHOG_HOST,
  PUBLIC_POSTHOG_KEY:
    import.meta.env.PUBLIC_POSTHOG_KEY ?? workersEnv.PUBLIC_POSTHOG_KEY,
});
---

<!doctype html>
<html lang="en" suppressHydrationWarning>
  <head>
    <script data-astro-rerun is:inline>
      (() => {
        const storageKey = "theme";
        const storedTheme = window.localStorage.getItem(storageKey);
        let preferredTheme = "light";
        if (storedTheme === "light" || storedTheme === "dark") {
          preferredTheme = storedTheme;
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          preferredTheme = "dark";
        }

        document.documentElement.classList.toggle(
          "dark",
          preferredTheme === "dark"
        );
        document.documentElement.style.colorScheme = preferredTheme;
      })();
    </script>
    <BaseHead
      canonicalUrl={canonicalUrl}
      fullTitle={fullTitle}
      meta={meta}
      rootDefaults={rootDefaults}
    />
    <JsonLd meta={meta} pathname={Astro.url.pathname} />
  </head>
  <body
    class="min-h-screen font-sans text-black antialiased selection:bg-blue-400/50 selection:text-blue-600 dark:text-neutral-300 dark:selection:bg-blue-950/50 dark:selection:text-blue-400"
  >
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-background focus:px-3 focus:py-2 focus:text-foreground focus:text-sm"
      href="#main"
    >
      Skip to main content
    </a>
    <div class="min-h-screen overflow-x-clip">
      <Navigation client:idle pathname={Astro.url.pathname} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    {posthog ? (
      <PostHogClient
        apiHost={posthog.apiHost}
        apiKey={posthog.apiKey}
        client:idle
      />
    ) : null}
  </body>
</html>
