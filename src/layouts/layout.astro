---
import "@/styles/globals.css";

import ActivityCapture from "@/components/activity-capture";
import Navigation from "@/components/navigation";
import BaseHead from "@/components/seo/base-head.astro";
import JsonLd from "@/components/seo/json-ld.astro";
import type { JsonLdCollectionItem } from "@/lib/json-ld";
import { menuItems } from "@/lib/menu-items";
import type { PageMetadata } from "@/lib/metadata";
import { siteLocale } from "@/lib/site";
import { DARK_MODE_QUERY, THEME_STORAGE_KEY } from "@/lib/theme";

const internalLink = {
  and: [
    { href_matches: "/*" },
    { not: { href_matches: "/api/*" } },
    { not: { selector_matches: "a[target=_blank]" } },
    { not: { selector_matches: "a[download]" } },
  ],
};

const speculationRules = JSON.stringify({
  prefetch: [
    {
      eagerness: "moderate",
      source: "document",
      where: internalLink,
    },
  ],
  prerender: [
    {
      eagerness: "immediate",
      source: "list",
      urls: ["/", ...menuItems.map((item) => item.href)],
    },
    {
      eagerness: "moderate",
      source: "document",
      where: internalLink,
    },
  ],
});

const themeBootScript = `(() => {
  const storageKey = ${JSON.stringify(THEME_STORAGE_KEY)};
  const storedTheme = window.localStorage.getItem(storageKey);
  let preferredTheme = "light";
  if (storedTheme === "light" || storedTheme === "dark") {
    preferredTheme = storedTheme;
  } else if (window.matchMedia(${JSON.stringify(DARK_MODE_QUERY)}).matches) {
    preferredTheme = "dark";
  }

  document.documentElement.classList.toggle("dark", preferredTheme === "dark");
  document.documentElement.style.colorScheme = preferredTheme;
})();`;

interface Props {
  canonicalUrl?: string;
  collectionItems?: JsonLdCollectionItem[];
  fullTitle: string;
  meta?: PageMetadata;
  rootDefaults?: boolean;
}

const {
  canonicalUrl,
  collectionItems,
  fullTitle,
  meta,
  rootDefaults = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteLocale} suppressHydrationWarning>
  <head>
    <meta charset="utf-8" />
    <link
      as="font"
      crossorigin
      href="/fonts/archivo.woff2"
      rel="preload"
      type="font/woff2"
    />
    <link
      as="font"
      crossorigin
      href="/fonts/redaction-regular.woff2"
      rel="preload"
      type="font/woff2"
    />
    <link
      as="font"
      crossorigin
      href="/fonts/geist-mono-latin-400.woff2"
      rel="preload"
      type="font/woff2"
    />
    <script data-astro-rerun is:inline set:html={themeBootScript} />
    <script is:inline set:html={speculationRules} type="speculationrules" />
    <BaseHead
      canonicalUrl={canonicalUrl}
      fullTitle={fullTitle}
      meta={meta}
      rootDefaults={rootDefaults}
    />
    <JsonLd
      collectionItems={collectionItems}
      meta={meta}
      pathname={Astro.url.pathname}
    />
  </head>
  <body
    class="min-h-screen font-sans text-black antialiased selection:bg-blue-400/50 selection:text-blue-600 dark:text-neutral-300 dark:selection:bg-blue-950/50 dark:selection:text-blue-400"
  >
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-background focus:px-3 focus:py-2 focus:text-foreground focus:text-sm"
      href="#main"
    >
      Skip to main content
    </a>
    <div class="min-h-screen overflow-x-clip">
      <Navigation client:idle pathname={Astro.url.pathname} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <ActivityCapture client:idle />
  </body>
</html>
