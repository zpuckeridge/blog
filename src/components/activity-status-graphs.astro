---
import StatusBarGraph from "@/components/status-bar-graph.astro";
import type { StatusHistoryPublic } from "@/lib/status-history";

interface Props {
  history: StatusHistoryPublic;
}

const { history } = Astro.props;
---

<div class="flex min-w-0 flex-col gap-10">
  <StatusBarGraph
    days={history.work}
    metricLabel="at work"
    title="At work"
    yearSummaryLabel="at work"
  />
  <StatusBarGraph
    days={history.home}
    metricLabel="at home"
    title="At home"
    yearSummaryLabel="at home"
  />
  <StatusBarGraph
    days={history.discord}
    metricLabel="Discord online"
    title="Discord online"
    yearSummaryLabel="Discord online"
  />
</div>

<script>
  import {
    CHART_POPOVER_CLASS,
    chartPopoverRect,
    placeChartPopover,
  } from "@/scripts/chart-popover";

  const initActivityStatusBars = () => {
    for (const graph of document.querySelectorAll("[data-status-bars]")) {
      if (!(graph instanceof HTMLElement) || graph.dataset.barsReady === "true") {
        continue;
      }

      graph.dataset.barsReady = "true";

      let tooltip = document.querySelector("[data-status-bars-tooltip]");
      if (!(tooltip instanceof HTMLElement)) {
        tooltip = document.createElement("div");
        tooltip.dataset.statusBarsTooltip = "";
        tooltip.setAttribute("role", "tooltip");
        tooltip.className = CHART_POPOVER_CLASS;
        document.body.append(tooltip);
      }

      const grid = graph.querySelector("[data-status-bars-grid]");
      if (!(grid instanceof HTMLElement)) {
        continue;
      }

      let hoveredDay = null;

      const hideTooltip = () => {
        tooltip.classList.add("hidden");
      };

      const showTooltip = (button) => {
        tooltip.textContent = button.dataset.label ?? "";
        placeChartPopover(tooltip, chartPopoverRect(button));
      };

      const setHoveredDay = (button) => {
        if (hoveredDay && hoveredDay !== button) {
          delete hoveredDay.dataset.hovered;
        }
        hoveredDay = button;
        button.dataset.hovered = "";
        showTooltip(button);
      };

      const clearHover = () => {
        if (hoveredDay) {
          delete hoveredDay.dataset.hovered;
          hoveredDay = null;
        }
        hideTooltip();
      };

      const days = [...grid.querySelectorAll("[data-status-bars-day]")].filter(
        (button) => button instanceof HTMLButtonElement
      );

      const focusDayAtIndex = (index) => {
        const cell = days[index];
        if (!(cell instanceof HTMLButtonElement)) {
          return;
        }
        for (const day of days) {
          day.tabIndex = -1;
        }
        cell.tabIndex = 0;
        cell.focus();
        setHoveredDay(cell);
      };

      grid.addEventListener("mouseleave", clearHover);
      grid.addEventListener("focusout", (event) => {
        if (!grid.contains(event.relatedTarget)) {
          clearHover();
        }
      });

      grid.addEventListener("keydown", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) {
          return;
        }

        const index = days.indexOf(event.target);
        if (index === -1) {
          return;
        }

        switch (event.key) {
          case "ArrowRight": {
            event.preventDefault();
            focusDayAtIndex(Math.min(index + 1, days.length - 1));
            break;
          }
          case "ArrowLeft": {
            event.preventDefault();
            focusDayAtIndex(Math.max(index - 1, 0));
            break;
          }
          default: {
            break;
          }
        }
      });

      for (const button of days) {
        button.addEventListener("mouseenter", () => {
          setHoveredDay(button);
        });
        button.addEventListener("focus", () => {
          setHoveredDay(button);
        });
      }
    }
  };

  initActivityStatusBars();
  document.addEventListener("astro:page-load", initActivityStatusBars);
  document.addEventListener("astro:before-preparation", () => {
    document.querySelector("[data-status-bars-tooltip]")?.remove();
  });
</script>