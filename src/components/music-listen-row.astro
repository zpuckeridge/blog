---
import { formatBrisbaneDateTime } from "@/lib/format-in-brisbane";
import { listenPlayedAt } from "@/lib/listening-history";
import type { ListenPlay } from "@/lib/listening-history";
import { resolveSafeHref } from "@/lib/safe-href";

interface Props {
  eager?: boolean;
  play: ListenPlay;
}

const { eager = false, play } = Astro.props;
const playedAt = listenPlayedAt(play);
const playedLabel = formatBrisbaneDateTime(playedAt);
const playedIso = new Date(playedAt).toISOString();
const trackHref = play.trackUrl ? resolveSafeHref(play.trackUrl) : null;
const artistHref = play.artistUrl ? resolveSafeHref(play.artistUrl) : null;
const artworkHref = play.artworkUrl ? resolveSafeHref(play.artworkUrl) : null;
const artworkSrc = artworkHref?.isExternal ? artworkHref.href : null;
const linkClass = "rounded-sm px-1 -mx-1 leading-[inherit] hover:bg-muted";
const summary = play.album
  ? `${play.track} • ${play.artist} • ${play.album}`
  : `${play.track} • ${play.artist}`;
---

<li class="flex min-w-0 items-start gap-3 border-border border-b border-dotted py-3">
  {
    artworkSrc ? (
      <div class="size-10 shrink-0 overflow-hidden rounded-sm bg-muted">
        <img
          alt={`${play.track} by ${play.artist}`}
          class="size-full object-cover"
          decoding="async"
          height="40"
          loading={eager ? "eager" : "lazy"}
          src={artworkSrc}
          width="40"
        />
      </div>
    ) : (
      <div aria-hidden="true" class="size-10 shrink-0 rounded-sm bg-muted/50" />
    )
  }
  <div class="min-w-0 flex-1">
    <p class="truncate text-sm leading-tight" title={summary}>
      {
        trackHref ? (
          <a
            class={linkClass}
            href={trackHref.href}
            rel={trackHref.isExternal ? "noopener noreferrer" : undefined}
            target={trackHref.isExternal ? "_blank" : undefined}
          >
            {play.track}
            {trackHref.isExternal ? (
              <span class="sr-only"> (opens in a new tab)</span>
            ) : null}
          </a>
        ) : (
          <span>{play.track}</span>
        )
      }
    </p>
    <p class="truncate text-sm leading-tight text-muted-foreground">
      {
        artistHref ? (
          <a
            class:list={["text-muted-foreground", linkClass]}
            href={artistHref.href}
            rel={artistHref.isExternal ? "noopener noreferrer" : undefined}
            target={artistHref.isExternal ? "_blank" : undefined}
          >
            {play.artist}
            {artistHref.isExternal ? (
              <span class="sr-only"> (opens in a new tab)</span>
            ) : null}
          </a>
        ) : (
          <span>{play.artist}</span>
        )
      }
      {
        play.album ? (
          <>
            <span aria-hidden="true" class="select-none">
              {" "}
              •{" "}
            </span>
            <span>{play.album}</span>
          </>
        ) : null
      }
    </p>
    <p class="mt-0.5 text-sm leading-tight text-muted-foreground tabular-nums">
      <time datetime={playedIso}>{playedLabel}</time>
    </p>
  </div>
</li>
