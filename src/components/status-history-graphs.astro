---
import StatusHeatmapGraph from "@/components/status-heatmap-graph.astro";
import type { StatusHistoryPublic } from "@/lib/status-history";

interface Props {
  history: StatusHistoryPublic;
}

const { history } = Astro.props;
---

<div class="flex min-w-0 flex-col gap-5">
  <div
    aria-hidden="true"
    class="fixed z-50 w-[min(32rem,calc(100vw-2rem))] -translate-x-1/2 space-y-8 rounded-md border border-border bg-popover p-3 text-popover-foreground opacity-0 pointer-events-none transition-opacity duration-150 ease-out"
    data-status-history-source="location"
    hidden
  >
    <StatusHeatmapGraph
      days={history.work}
      metricLabel="at work"
      title="At work"
      yearSummaryLabel="at work"
    />
    <StatusHeatmapGraph
      days={history.home}
      metricLabel="at home"
      title="At home"
      yearSummaryLabel="at home"
    />
  </div>
  <div
    aria-hidden="true"
    class="fixed z-50 w-[min(32rem,calc(100vw-2rem))] -translate-x-1/2 rounded-md border border-border bg-popover p-3 text-popover-foreground opacity-0 pointer-events-none transition-opacity duration-150 ease-out"
    data-status-history-source="discord"
    hidden
  >
    <StatusHeatmapGraph
      days={history.discord}
      metricLabel="Discord online"
      title="Discord online"
      yearSummaryLabel="Discord online"
    />
  </div>
</div>

<script>
  const hideDelays = new Map();
  const activeSources = new Map();
  const sourceTriggers = new Map();

  const positionSource = (source) => {
    const target = document.querySelector(
      `[data-status-history-source="${source}"]`
    );
    const trigger = sourceTriggers.get(source);
    if (!(target instanceof HTMLElement) || !(trigger instanceof HTMLElement)) {
      return;
    }

    const triggerRect = trigger.getBoundingClientRect();
    target.style.left = `${triggerRect.left + triggerRect.width / 2}px`;
    target.style.bottom = `${window.innerHeight - triggerRect.top + 8}px`;
    target.style.top = "auto";
  };

  const setSourceVisibility = (source, visible) => {
    const target = document.querySelector(
      `[data-status-history-source="${source}"]`
    );
    if (!(target instanceof HTMLElement)) {
      return;
    }

    target.hidden = false;
    target.setAttribute("aria-hidden", String(!visible));
    if (visible) {
      target.classList.add("opacity-0", "pointer-events-auto");
      target.classList.remove("opacity-100", "pointer-events-none");
      requestAnimationFrame(() => {
        if (activeSources.get(source)) {
          target.classList.add("opacity-100");
          target.classList.remove("opacity-0");
        }
      });
    } else {
      target.classList.add("opacity-0", "pointer-events-none");
      target.classList.remove("opacity-100", "pointer-events-auto");
    }
  };

  const cancelHide = (source) => {
    const timeout = hideDelays.get(source);
    if (timeout !== undefined) {
      window.clearTimeout(timeout);
      hideDelays.delete(source);
    }
  };

  const showSource = (source) => {
    cancelHide(source);
    activeSources.set(source, true);
    positionSource(source);
    setSourceVisibility(source, true);
  };

  const scheduleHide = (source) => {
    cancelHide(source);
    hideDelays.set(
      source,
      window.setTimeout(() => {
        hideDelays.delete(source);
        if (!activeSources.get(source)) {
          setSourceVisibility(source, false);
        }
      }, 120)
    );
  };

  const setSourceActive = (source, active, trigger) => {
    if (trigger instanceof HTMLElement) {
      sourceTriggers.set(source, trigger);
    }
    activeSources.set(source, active);
    if (active) {
      showSource(source);
    } else {
      scheduleHide(source);
    }
  };

  const bindSourceTrigger = (selector, source) => {
    for (const trigger of document.querySelectorAll(selector)) {
      if (
        !(trigger instanceof HTMLElement) ||
        trigger.dataset.statusHistoryTriggerReady === "true"
      ) {
        continue;
      }

      trigger.dataset.statusHistoryTriggerReady = "true";
      trigger.addEventListener("pointerenter", () => {
        setSourceActive(source, true, trigger);
      });
      trigger.addEventListener("pointerleave", () => {
        setSourceActive(source, false);
      });
      trigger.addEventListener("focusin", () => {
        setSourceActive(source, true, trigger);
      });
      trigger.addEventListener("focusout", (event) => {
        if (!trigger.contains(event.relatedTarget)) {
          setSourceActive(source, false);
        }
      });
    }
  };

  const bindSourceGraph = (source) => {
    const graph = document.querySelector(
      `[data-status-history-source="${source}"]`
    );
    if (
      !(graph instanceof HTMLElement) ||
      graph.dataset.statusHistoryGraphReady === "true"
    ) {
      return;
    }

    graph.dataset.statusHistoryGraphReady = "true";
    graph.addEventListener("pointerenter", () => {
      setSourceActive(source, true);
    });
    graph.addEventListener("pointerleave", () => {
      setSourceActive(source, false);
    });
    graph.addEventListener("focusin", () => {
      setSourceActive(source, true);
    });
    graph.addEventListener("focusout", (event) => {
      if (!graph.contains(event.relatedTarget)) {
        setSourceActive(source, false);
      }
    });
  };

  const initStatusHistoryReveal = () => {
    bindSourceTrigger("[data-location-status]", "location");
    bindSourceTrigger("[data-lanyard-status]", "discord");
    bindSourceGraph("location");
    bindSourceGraph("discord");
  };

  const repositionVisibleSources = () => {
    for (const source of activeSources.keys()) {
      if (activeSources.get(source)) {
        positionSource(source);
      }
    }
  };

  const initStatusHeatmaps = () => {
    for (const graph of document.querySelectorAll("[data-status-heatmap]")) {
      if (!(graph instanceof HTMLElement) || graph.dataset.heatmapReady === "true") {
        continue;
      }

      graph.dataset.heatmapReady = "true";

      let tooltip = document.querySelector("[data-status-heatmap-tooltip]");
      if (!(tooltip instanceof HTMLElement)) {
        tooltip = document.createElement("div");
        tooltip.dataset.statusHeatmapTooltip = "";
        tooltip.setAttribute("role", "tooltip");
        tooltip.className =
          "pointer-events-none fixed z-50 hidden w-max max-w-[16rem] -translate-x-1/2 -translate-y-full rounded-md border border-border bg-popover px-3 py-2 text-popover-foreground text-xs shadow-md";
        document.body.append(tooltip);
      }

      const grid = graph.querySelector("[data-status-heatmap-grid]");
      if (!(grid instanceof HTMLElement)) {
        continue;
      }

      let hoveredDay = null;

      const hideTooltip = () => {
        tooltip.classList.add("hidden");
      };

      const showTooltip = (button) => {
        const rect = button.getBoundingClientRect();
        tooltip.textContent = button.dataset.label ?? "";
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.top - 6}px`;
        tooltip.classList.remove("hidden");
      };

      const setHoveredDay = (button) => {
        if (hoveredDay && hoveredDay !== button) {
          delete hoveredDay.dataset.hovered;
        }
        hoveredDay = button;
        button.dataset.hovered = "";
        showTooltip(button);
      };

      const clearHover = () => {
        if (hoveredDay) {
          delete hoveredDay.dataset.hovered;
          hoveredDay = null;
        }
        hideTooltip();
      };

      const days = [...grid.querySelectorAll("[data-status-heatmap-day]")].filter(
        (button) => button instanceof HTMLButtonElement
      );

      const columns = [...grid.children].filter(
        (child) => child instanceof HTMLElement
      );

      const locateDay = (button) => {
        for (const [weekIndex, column] of columns.entries()) {
          const cells = [...column.children];
          const dayIndex = cells.indexOf(button);
          if (dayIndex !== -1) {
            return { dayIndex, weekIndex };
          }
        }
        return null;
      };

      const focusDay = (weekIndex, dayIndex, deltaWeek, deltaDay) => {
        let nextWeek = weekIndex + deltaWeek;
        let nextDay = dayIndex + deltaDay;
        while (
          nextWeek >= 0 &&
          nextWeek < columns.length &&
          nextDay >= 0 &&
          nextDay < 7
        ) {
          const cell = columns[nextWeek]?.children[nextDay];
          if (cell instanceof HTMLButtonElement) {
            for (const day of days) {
              day.tabIndex = -1;
            }
            cell.tabIndex = 0;
            cell.focus();
            return;
          }
          nextWeek += deltaWeek;
          nextDay += deltaDay;
        }
      };

      grid.addEventListener("mouseleave", clearHover);
      grid.addEventListener("focusout", (event) => {
        if (!grid.contains(event.relatedTarget)) {
          clearHover();
        }
      });

      grid.addEventListener("keydown", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) {
          return;
        }

        const location = locateDay(event.target);
        if (!location) {
          return;
        }

        switch (event.key) {
          case "ArrowDown": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 0, 1);
            break;
          }
          case "ArrowUp": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 0, -1);
            break;
          }
          case "ArrowRight": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 1, 0);
            break;
          }
          case "ArrowLeft": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, -1, 0);
            break;
          }
          default: {
            break;
          }
        }
      });

      for (const button of days) {
        button.addEventListener("mouseenter", () => {
          setHoveredDay(button);
        });
        button.addEventListener("focus", () => {
          setHoveredDay(button);
        });
      }
    }
  };

  initStatusHistoryReveal();
  initStatusHeatmaps();
  window.addEventListener("resize", repositionVisibleSources);
  window.addEventListener("scroll", repositionVisibleSources, { passive: true });
  document.addEventListener("astro:page-load", () => {
    initStatusHistoryReveal();
    initStatusHeatmaps();
  });
  document.addEventListener("astro:before-preparation", () => {
    document.querySelector("[data-status-heatmap-tooltip]")?.remove();
  });
</script>
