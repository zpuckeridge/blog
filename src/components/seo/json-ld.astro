---
import { buildJsonLdPayload } from "@/lib/json-ld";
import type { JsonLdCollectionItem } from "@/lib/json-ld";
import type { PageMetadata } from "@/lib/metadata";

interface Props {
  collectionItems?: JsonLdCollectionItem[];
  meta?: PageMetadata;
  pathname: string;
}

const { collectionItems, meta, pathname } = Astro.props;
const og = meta?.openGraph;

const ogImages = (() => {
  if (!og?.images) {
    return [];
  }
  if (Array.isArray(og.images)) {
    return og.images;
  }
  return [og.images];
})();

const payload = buildJsonLdPayload({
  collectionItems,
  description: meta?.description,
  imageUrls: ogImages.map((image) => image.url),
  keywords: og?.tags,
  modifiedTime: og?.modifiedTime,
  pathname,
  publishedTime: og?.publishedTime,
  title: typeof meta?.title === "string" ? meta.title : og?.title,
  type: og?.type,
  url: og?.url,
});
---

{
  payload && (
    <script set:html={JSON.stringify(payload)} type="application/ld+json" />
  )
}
