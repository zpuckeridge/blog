---
import { getContributionColor, summarizeContributions } from "@/lib/contributions-graph";
import type { ContributionDay } from "@/lib/contributions-graph";

interface Props {
  contributions: ContributionDay[];
}

const { contributions } = Astro.props;
const {
  currentYear,
  formatDayLabel,
  maxContributionCount,
  todayIso,
  weeks,
  yearTotalContributions,
} = summarizeContributions(contributions);
const firstDayDate = weeks.flat().find((day) => day !== null)?.date ?? null;
const initialTabDate = todayIso || firstDayDate;
---

<div
  class="w-full border-0 bg-transparent p-0 text-left"
  data-contributions-graph
>
  <div class="space-y-2">
    <div
      class="flex justify-end gap-[4px] overflow-hidden"
      data-contribution-grid
    >
      {
        weeks.map((week) => (
            <div class="flex flex-col gap-[4px]">
              {week.map((day) =>
                day ? (
                  <button
                    aria-label={formatDayLabel(day)}
                    class:list={[
                      "contribution-day h-[9px] w-[9px]",
                      getContributionColor(
                        day.contributionCount,
                        maxContributionCount
                      ),
                      day.date === todayIso && "contribution-day-today",
                    ]}
                    data-contribution-day
                    data-label={formatDayLabel(day)}
                    tabindex={day.date === initialTabDate ? 0 : -1}
                    type="button"
                  />
                ) : (
                  <div aria-hidden="true" class="h-[9px] w-[9px]" />
                )
              )}
            </div>
          ))
      }
    </div>
    <div class="text-muted-foreground text-sm" data-contribution-summary>
      {`${yearTotalContributions} contribution${yearTotalContributions === 1 ? "" : "s"} in ${currentYear}`}
    </div>
  </div>
</div>

<script>
  const initContributionGraphs = () => {
    for (const graph of document.querySelectorAll("[data-contributions-graph]")) {
      if (!(graph instanceof HTMLElement) || graph.dataset.graphReady === "true") {
        continue;
      }

      graph.dataset.graphReady = "true";

      let tooltip = document.querySelector("[data-contribution-tooltip]");
      if (!(tooltip instanceof HTMLElement)) {
        tooltip = document.createElement("div");
        tooltip.dataset.contributionTooltip = "";
        tooltip.setAttribute("role", "tooltip");
        tooltip.className =
          "pointer-events-none fixed z-50 hidden w-max max-w-[16rem] -translate-x-1/2 -translate-y-full rounded-md border border-border bg-popover px-3 py-2 text-popover-foreground text-xs shadow-md";
        document.body.append(tooltip);
      }

      const grid = graph.querySelector("[data-contribution-grid]");
      if (!(grid instanceof HTMLElement)) {
        continue;
      }

      let hoveredDay = null;

      const hideTooltip = () => {
        tooltip.classList.add("hidden");
      };

      const showTooltip = (button) => {
        const rect = button.getBoundingClientRect();
        tooltip.textContent = button.dataset.label ?? "";
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.top - 6}px`;
        tooltip.classList.remove("hidden");
      };

      const setHoveredDay = (button) => {
        if (hoveredDay && hoveredDay !== button) {
          delete hoveredDay.dataset.hovered;
        }
        hoveredDay = button;
        button.dataset.hovered = "";
        showTooltip(button);
      };

      const clearHover = () => {
        if (hoveredDay) {
          delete hoveredDay.dataset.hovered;
          hoveredDay = null;
        }
        hideTooltip();
      };

      const days = [...grid.querySelectorAll("[data-contribution-day]")].filter(
        (button) => button instanceof HTMLButtonElement
      );

      const columns = [...grid.children].filter(
        (child) => child instanceof HTMLElement
      );

      const locateDay = (button) => {
        for (const [weekIndex, column] of columns.entries()) {
          const cells = [...column.children];
          const dayIndex = cells.indexOf(button);
          if (dayIndex !== -1) {
            return { dayIndex, weekIndex };
          }
        }
        return null;
      };

      const focusDay = (weekIndex, dayIndex, deltaWeek, deltaDay) => {
        let nextWeek = weekIndex + deltaWeek;
        let nextDay = dayIndex + deltaDay;
        while (
          nextWeek >= 0 &&
          nextWeek < columns.length &&
          nextDay >= 0 &&
          nextDay < 7
        ) {
          const cell = columns[nextWeek]?.children[nextDay];
          if (cell instanceof HTMLButtonElement) {
            for (const day of days) {
              day.tabIndex = -1;
            }
            cell.tabIndex = 0;
            cell.focus();
            return;
          }
          nextWeek += deltaWeek;
          nextDay += deltaDay;
        }
      };

      // Clear hover only when leaving the whole grid — not between cells
      // or across the 4px column gap — so highlight and tooltip stay put.
      grid.addEventListener("mouseleave", clearHover);
      grid.addEventListener("focusout", (event) => {
        if (!grid.contains(event.relatedTarget)) {
          clearHover();
        }
      });

      grid.addEventListener("keydown", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) {
          return;
        }

        const location = locateDay(event.target);
        if (!location) {
          return;
        }

        switch (event.key) {
          case "ArrowDown": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 0, 1);
            break;
          }
          case "ArrowUp": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 0, -1);
            break;
          }
          case "ArrowRight": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, 1, 0);
            break;
          }
          case "ArrowLeft": {
            event.preventDefault();
            focusDay(location.weekIndex, location.dayIndex, -1, 0);
            break;
          }
          default: {
            break;
          }
        }
      });

      for (const button of days) {
        button.addEventListener("mouseenter", () => {
          setHoveredDay(button);
        });
        button.addEventListener("focus", () => {
          setHoveredDay(button);
        });
      }
    }
  };

  initContributionGraphs();
  document.addEventListener("astro:page-load", initContributionGraphs);
  document.addEventListener("astro:before-preparation", () => {
    document.querySelector("[data-contribution-tooltip]")?.remove();
  });
</script>
