---
import RhythmChartEmpty from "@/components/rhythm-chart-empty.astro";
import {
  formatHeatmapDelta,
  formatHeatmapMinutesLabel,
  summarizeHeatmap,
} from "@/lib/calendar-heatmap";
import type { HeatmapDay } from "@/lib/calendar-heatmap";
import { formatPublishedShortDayMonth } from "@/lib/format-in-brisbane";

interface Props {
  days: HeatmapDay[];
  metricLabel: string;
  title: string;
  yearSummaryLabel: string;
}

const DAY_MINUTES = 24 * 60;
const { days, metricLabel, title, yearSummaryLabel } = Astro.props;
const {
  averageMinutes,
  days: strip,
  deltaMinutes,
  formatDayLabel,
  loggedDays,
  todayIso,
  yearTotalMinutes,
} = summarizeHeatmap(days, metricLabel);
const deltaLabel =
  deltaMinutes === null ? null : formatHeatmapDelta(deltaMinutes);
const [firstDay] = strip;
const lastDay = strip.at(-1);
const rangeLabel =
  firstDay && lastDay
    ? `${formatPublishedShortDayMonth(firstDay.date)} – ${formatPublishedShortDayMonth(lastDay.date)}`
    : "";
const initialTabDate = todayIso || firstDay?.date;
const hasAnyData = days.some((day) => day.hasData);
const averageLabel =
  loggedDays > 0
    ? `${formatHeatmapMinutesLabel(averageMinutes)} per logged day`
    : null;

const columns = strip.map((day) => {
  let barHeight: string | null = null;
  if (day.hasData) {
    barHeight =
      day.value <= 0
        ? "1.5px"
        : `${Math.min(1, day.value / DAY_MINUTES) * 100}%`;
  }

  return {
    barHeight,
    date: day.date,
    label: formatDayLabel(day),
  };
});
---

<section
  aria-label={`${title} history`}
  class="w-full border-0 bg-transparent p-0 text-left"
  data-status-bars
>
  <div class="space-y-3">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 class="font-normal text-muted-foreground text-sm">{title}</h3>
      {
        rangeLabel ? (
          <p class="text-muted-foreground text-xs">{rangeLabel}</p>
        ) : null
      }
    </div>
    {
      hasAnyData ? (
        <>
          <div class="relative aspect-[360/112] w-full">
            <div
              class="absolute inset-x-0 top-2 bottom-2.5 flex items-end border-b border-border"
              data-status-bars-grid
            >
              {
                columns.map((day) => (
                  <button
                    aria-label={day.label}
                    class="group relative h-full min-w-0 flex-1 focus-visible:bg-foreground/5 focus-visible:outline-none"
                    data-label={day.label}
                    data-status-bars-day
                    tabindex={day.date === initialTabDate ? 0 : -1}
                    type="button"
                  >
                    {day.barHeight ? (
                      <span
                        class="absolute inset-x-[14%] bottom-0 bg-foreground/30 group-data-[hovered]:bg-foreground/55"
                        data-chart-bar
                        style={`height: ${day.barHeight}`}
                      />
                    ) : null}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="space-y-0.5 text-muted-foreground text-sm" data-status-bars-summary>
            <p class="tabular-nums">
              {`${formatHeatmapMinutesLabel(yearTotalMinutes)} ${yearSummaryLabel} in the last 30 days`}
              {deltaLabel ? ` · ${deltaLabel}` : ""}
            </p>
            {averageLabel ? <p class="text-xs">{averageLabel}</p> : null}
          </div>
        </>
      ) : (
        <RhythmChartEmpty
          label={`No ${metricLabel} history yet`}
          variant="bars"
        />
      )
    }
  </div>
</section>
