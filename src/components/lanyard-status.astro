---
import { LANYARD_USER_ID } from "@/lib/lanyard-status";
---

<div
  aria-label="Discord status"
  class="group/lanyard relative flex h-5 shrink-0 items-center gap-2"
  data-lanyard-status
  data-lanyard-user={LANYARD_USER_ID}
  tabindex="0"
>
  <div
    class="my-auto h-2 w-2 shrink-0 bg-gray-400"
    data-lanyard-dot
    data-status-dot
  />
  <p
    class="my-auto whitespace-nowrap text-muted-foreground text-sm"
    data-lanyard-label
  >
    Offline
  </p>
</div>

<script>
  import { scheduleIdleOrFallback } from "@/lib/defer-after-idle";
  import { isLikelyBot } from "@/lib/is-likely-bot";
  import {
    teardownLanyardPresenceHub,
    watchLanyardPresence,
  } from "@/lib/lanyard-presence-hub";
  import { getDiscordStatusStyle } from "@/lib/lanyard-status";
  import { syncStatusPulse } from "@/lib/sync-status-pulse";

  const activeSubscriptions = new Set<() => void>();

  const initLanyardStatus = () => {
    for (const root of document.querySelectorAll("[data-lanyard-status]")) {
      if (!(root instanceof HTMLElement) || root.dataset.lanyardReady === "true") {
        continue;
      }

      const dot = root.querySelector("[data-lanyard-dot]");
      const label = root.querySelector("[data-lanyard-label]");
      const userId = root.dataset.lanyardUser;

      if (
        !(dot instanceof HTMLElement) ||
        !(label instanceof HTMLElement) ||
        !userId
      ) {
        continue;
      }

      root.dataset.lanyardReady = "true";

      if (isLikelyBot()) {
        continue;
      }

      const applyStatus = (discordStatus: string | undefined) => {
        const style = getDiscordStatusStyle(discordStatus);
        const shouldPulse = discordStatus !== "offline";
        dot.className = `my-auto h-2 w-2 shrink-0 ${style.color}`;
        syncStatusPulse(dot, shouldPulse);
        label.textContent = style.text;
      };

      const unsubscribe = watchLanyardPresence(userId, (presence) => {
        applyStatus(presence.discord_status);
      });

      activeSubscriptions.add(unsubscribe);
    }
  };

  const scheduleLanyardInit = () => {
    scheduleIdleOrFallback(initLanyardStatus, 1500);
  };

  const teardownLanyardStatus = () => {
    for (const unsubscribe of activeSubscriptions) {
      unsubscribe();
    }

    activeSubscriptions.clear();
    teardownLanyardPresenceHub();
  };

  scheduleLanyardInit();
  document.addEventListener("astro:page-load", scheduleLanyardInit);
  document.addEventListener("astro:before-swap", teardownLanyardStatus);
</script>
