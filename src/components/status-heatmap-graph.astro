---
import { formatHeatmapMinutesLabel, getHoursHeatmapColor, summarizeHeatmap } from '@/lib/calendar-heatmap';
import type { HeatmapDay } from '@/lib/calendar-heatmap';

interface Props {
  days: HeatmapDay[];
  metricLabel: string;
  title: string;
  yearSummaryLabel: string;
}

const { days, metricLabel, title, yearSummaryLabel } = Astro.props;
const { currentYear, formatDayLabel, todayIso, weeks, yearTotalMinutes } =
  summarizeHeatmap(days, metricLabel);
const firstDayDate = weeks.flat().find((day) => day !== null)?.date ?? null;
const initialTabDate = todayIso || firstDayDate;
const hasAnyData = days.some((day) => day.hasData);
---

<section
  aria-label={`${title} history`}
  class="w-full border-0 bg-transparent p-0 text-left"
  data-status-heatmap
>
  <div class="space-y-2">
    <h3 class="text-muted-foreground text-sm font-normal">{title}</h3>
    {
      hasAnyData ? (
        <>
          <div
            class="flex justify-end gap-[4px] overflow-hidden"
            data-status-heatmap-grid
          >
            {weeks.map((week) => (
              <div class="flex flex-col gap-[4px]">
                {week.map((day) =>
                  day ? (
                    <button
                      aria-label={formatDayLabel(day)}
                      class:list={[
                        "contribution-day h-[9px] w-[9px]",
                        getHoursHeatmapColor(day.value, day.hasData),
                        day.date === todayIso && day.hasData && "contribution-day-today",
                      ]}
                      data-label={formatDayLabel(day)}
                      data-status-heatmap-day
                      tabindex={day.date === initialTabDate ? 0 : -1}
                      type="button"
                    />
                  ) : (
                    <div aria-hidden="true" class="h-[9px] w-[9px]" />
                  )
                )}
              </div>
            ))}
          </div>
          <div class="text-muted-foreground text-sm" data-status-heatmap-summary>
            {`${formatHeatmapMinutesLabel(yearTotalMinutes)} ${yearSummaryLabel} in ${currentYear}`}
          </div>
        </>
      ) : (
        <div
          class="relative overflow-hidden rounded-md border border-border border-dashed bg-muted/20 p-3"
          role="status"
        >
          <div
            aria-hidden="true"
            class="flex justify-end gap-[4px] opacity-45"
          >
            {
              Array.from({ length: 52 }, () => (
                <div class="flex flex-col gap-[4px]">
                  {Array.from({ length: 7 }, () => (
                    <span class="h-[9px] w-[9px] bg-neutral-100 dark:bg-neutral-900" />
                  ))}
                </div>
              ))
            }
          </div>
          <div class="absolute inset-0 flex items-center justify-center bg-popover/55">
            <p class="text-sm">No {metricLabel} history yet</p>
          </div>
        </div>
      )
    }
  </div>
</section>
