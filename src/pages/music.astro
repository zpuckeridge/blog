---
import MusicHistory from "@/components/music-history";
import MusicStats from "@/components/music-stats";
import Layout from "@/layouts/layout.astro";
import {
  filterListenHistoryByMonth,
  LISTENING_HISTORY_DISPLAY_MAX,
  LISTENING_HISTORY_KV_KEY,
  readListenHistory,
  sliceListenHistory,
} from "@/lib/listening-history";
import { listenMonthKey } from "@/lib/listening-month";
import {
  LISTENING_STATS_KV_KEY,
  parseListeningStats,
  resolveListeningStatsMonth,
} from "@/lib/listening-stats";
import { createPageMetadata, formatPageTitle } from "@/lib/metadata";
import { workersEnv } from "@/lib/workers-env";

export const prerender = false;

if (Astro.url.searchParams.has("page")) {
  return Astro.redirect("/music", 302);
}

const kv = workersEnv.LOCATION_KV;
if (kv) {
  const { ensureDevMusicSeed } = await import("@/lib/music-stats-dev-seed");
  await ensureDevMusicSeed(kv);
}

const [listeningRaw, statsRaw] = kv
  ? await Promise.all([
      kv.get(LISTENING_HISTORY_KV_KEY),
      kv.get(LISTENING_STATS_KV_KEY),
    ])
  : [null, null];

const history = readListenHistory(listeningRaw);
const stats = parseListeningStats(statsRaw);
const { initialMonth, months } = resolveListeningStatsMonth(
  stats,
  Astro.url.searchParams.get("month")
);
const monthHistory = filterListenHistoryByMonth(history, initialMonth);
const listing = sliceListenHistory(
  monthHistory,
  0,
  LISTENING_HISTORY_DISPLAY_MAX
);
const isLiveMonth = initialMonth === listenMonthKey(Date.now());

Astro.response.headers.set("Cache-Control", "private, no-store");

const pageMeta = createPageMetadata({
  description:
    "Recent Apple Music listening: monthly genre plays, top tracks, artists, albums, and plays for the selected month.",
  path: "/music",
  title: "Music",
});

const fullTitle = formatPageTitle("Music");
---

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  <div class="mx-auto flex w-full min-w-0 max-w-lg flex-col gap-8 px-6 pb-20">
    <div class="space-y-2">
      <h1 class="font-redaction text-black text-xl dark:text-white">Music</h1>
      <p class="text-sm text-muted-foreground">
        Monthly stats and plays for the selected month, newest first.
      </p>
    </div>

    <MusicStats
      client:idle
      initialMonth={initialMonth}
      monthPagePath="/music"
      months={months}
      stats={stats}
    />

    <MusicHistory
      client:idle
      initialPlays={listing.plays}
      live={isLiveMonth}
      monthKey={initialMonth}
    />
  </div>
</Layout>