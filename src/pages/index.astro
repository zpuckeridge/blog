---
import AnimatedGradientText from "@/components/animated-gradient-text.astro";
import BrisbaneDateTime from "@/components/brisbane-datetime.astro";
import ContributionsGraphStatic from "@/components/contributions-graph-static.astro";
import GitHubContributions from "@/components/contributions-graph";
import Layout from "@/layouts/layout.astro";
import LanyardListening from "@/components/lanyard-listening.astro";
import LanyardStatus from "@/components/lanyard-status.astro";
import LocationStatus from "@/components/location-status.astro";
import LinkWithIcon from "@/components/link-with-icon.astro";
import ToggleTheme from "@/components/toggle-theme.astro";
import { isNewPost, NEW_POST_TAG } from "@/lib/is-new-post";
import { createPageMetadata } from "@/lib/metadata";
import { getPosts, getProjects } from "@/lib/directus-content";
import {
  fetchGitHubContributions,
  getCachedGitHubContributions,
  getGitHubToken,
} from "@/lib/github-contributions";
import { getServerLocationStatus } from "@/lib/location-status";
import type { ContributionDay } from "@/lib/github-contributions";

const [posts, projects, initialLocation] = await Promise.all([
  getPosts(),
  getProjects(),
  getServerLocationStatus(),
]);
const sortedPosts = posts.toSorted(
  (a, b) =>
    new Date(b.date_created).getTime() - new Date(a.date_created).getTime()
);
const sortedProjects = projects.toSorted((a, b) => {
  if (a.status === "work_in_progress" && b.status !== "work_in_progress") {
    return -1;
  }
  if (a.status !== "work_in_progress" && b.status === "work_in_progress") {
    return 1;
  }
  if (a.status === "archived" && b.status !== "archived") {
    return 1;
  }
  if (a.status !== "archived" && b.status === "archived") {
    return -1;
  }
  if (a.year_completed && b.year_completed) {
    return b.year_completed - a.year_completed;
  }
  if (a.year_completed && !b.year_completed) {
    return -1;
  }
  if (!a.year_completed && b.year_completed) {
    return 1;
  }
  return (
    new Date(b.date_created).getTime() - new Date(a.date_created).getTime()
  );
});
const githubUsername = "zpuckeridge";
const githubContributions = await (async (): Promise<
  ContributionDay[] | undefined
> => {
  const cachedContributions = getCachedGitHubContributions(githubUsername);
  if (cachedContributions) {
    return cachedContributions;
  }

  const token = getGitHubToken();
  if (!token) {
    return undefined;
  }

  try {
    return await fetchGitHubContributions(token, githubUsername);
  } catch (error) {
    console.error("Failed to preload GitHub contributions", error);
    return undefined;
  }
})();
const currentYear = new Date().getFullYear();

const homepageTitle =
  "Zacchary Puckeridge — Web developer and writer, Brisbane";
const homepageDescription =
  "Web developer and writer in Brisbane. IT Operations Lead at Star Compass and Haddon Institute; also runs obambulo studio. Read the latest on the timeline.";

const pageMeta = createPageMetadata({
  description: homepageDescription,
  path: "/",
  title: homepageTitle,
});

const fullTitle = homepageTitle;
---

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
  rootDefaults
>
  <div class="mx-auto flex w-full min-w-0 max-w-lg flex-col gap-4 px-6 pb-20">
    <div class="min-w-0 space-y-10">
      <div class="space-y-4">
        <div class="space-y-2 text-sm">
          <h1 class="font-redaction text-xl text-black dark:text-white">
            Zacchary Puckeridge
          </h1>
          <div>
            <p>Self-taught Web Developer & Generalist</p>
            <p>Based in Brisbane, Australia</p>
          </div>
        </div>

        <div class="flex flex-col gap-4 md:flex-row md:justify-between">
          <div class="-ml-1 flex min-w-0 flex-row flex-wrap gap-2 text-sm text-muted-foreground">
            <LinkWithIcon href="https://x.com/zpuckeridge/" variant="default">
              X
            </LinkWithIcon>
            <LinkWithIcon
              href="https://www.facebook.com/zpuckeridge/"
              variant="default"
            >
              Facebook
            </LinkWithIcon>
            <LinkWithIcon
              href="https://www.instagram.com/zpuckeridge/"
              variant="default"
            >
              Instagram
            </LinkWithIcon>
            <LinkWithIcon
              href="https://www.linkedin.com/in/zpuckeridge/"
              variant="default"
            >
              LinkedIn
            </LinkWithIcon>
            <LinkWithIcon href="https://github.com/zpuckeridge" variant="default">
              GitHub
            </LinkWithIcon>
          </div>

          <div>
            <p class="text-nowrap text-sm text-muted-foreground">
              &copy; {currentYear}
            </p>
          </div>
        </div>
      </div>

      <div class="space-y-10">
        <hr class="border-dotted border-border" />

        <div class="flex min-w-0 flex-row items-baseline gap-4 text-sm leading-normal">
          <div class="w-20 shrink-0">
            <p class="text-muted-foreground">Now</p>
          </div>

          <div class="min-w-0 flex-1 space-y-2">
            <p>
              IT Operations Lead at{" "}
              <LinkWithIcon href="https://www.starcompass.com.au">
                Star Compass
              </LinkWithIcon>{" "}
              and{" "}
              <LinkWithIcon href="https://www.haddoninstitute.org">
                Haddon Institute
              </LinkWithIcon>
              . I also run{" "}
              <LinkWithIcon href="https://obambulo.studio">
                obambulo studio
              </LinkWithIcon>
              .
            </p>
          </div>
        </div>

        <div class="flex min-w-0 flex-row items-baseline gap-4 text-sm leading-normal">
          <div class="w-20 shrink-0">
            <p class="text-muted-foreground">Prev</p>
          </div>

          <div class="min-w-0 flex-1 space-y-2">
            <p>
              IT Administrator at{" "}
              <LinkWithIcon href="https://www.rsp.com.au">
                Rising Sun Pictures
              </LinkWithIcon>{" "}
              (<span class="inline-flex items-center gap-1">
                2022 <span aria-hidden="true">→</span> 2024
              </span>). Systems Administrator at{" "}
              <LinkWithIcon href="https://www.pixelzoo.com.au">
                Pixel Zoo
              </LinkWithIcon>{" "}
              (<span class="inline-flex items-center gap-1">
                2021 <span aria-hidden="true">→</span> 2022
              </span>).
            </p>

            <p class="text-sm text-muted-foreground">
              You can find my{" "}
              <a
                class="group inline-block max-w-full whitespace-nowrap bg-muted px-1 leading-[inherit] hover:bg-muted/80"
                href="/cv"
              >full employment history on my CV</a>.
            </p>
          </div>
        </div>

        <div class="min-w-0 space-y-10 border-t border-dotted border-border pt-10">
          <div class="min-w-0 space-y-2">
            <div class="flex min-w-0 w-full flex-row items-baseline gap-4 text-sm leading-normal">
              <div class="w-20 shrink-0">
                <h2 class="text-muted-foreground text-sm font-normal">Timeline</h2>
              </div>

              <div class="flex min-w-0 w-full flex-col gap-1">
                {sortedPosts.slice(0, 4).map((post) => {
                  const isRecent = isNewPost(post.date_created);
                  return (
                    <a
                      aria-label={
                        isRecent
                          ? `${NEW_POST_TAG}: ${post.title}`
                          : post.title
                      }
                      class="flex min-w-0 justify-between gap-4 px-1 hover:bg-muted"
                      href={`/timeline/${post.slug}`}
                    >
                      <div class="flex min-w-0 items-baseline gap-1">
                        {isRecent && (
                          <span
                            aria-hidden="true"
                            class="inline-flex shrink-0 bg-muted px-1 text-muted-foreground"
                          >
                            {NEW_POST_TAG}
                          </span>
                        )}
                        <p class="min-w-0 line-clamp-1">{post.title}</p>
                      </div>
                      <p class="text-muted-foreground">
                        {new Date(post.date_created).toLocaleDateString(
                          undefined,
                          {
                            day: "2-digit",
                            month: "2-digit",
                            year: "numeric",
                          }
                        )}
                      </p>
                    </a>
                  );
                })}
              </div>
            </div>
            <div class="flex justify-end">
              <a
                class="text-sm text-muted-foreground px-1 hover:bg-muted"
                href="/timeline"
              >
                See all {sortedPosts.length} timeline posts
              </a>
            </div>
          </div>

          <div class="min-w-0 space-y-2">
            <div class="flex min-w-0 w-full flex-row items-baseline gap-4 text-sm leading-normal">
              <div class="w-20 shrink-0">
                <h2 class="text-muted-foreground text-sm font-normal">Projects</h2>
              </div>
              <div class="flex min-w-0 w-full flex-col gap-1">
                {sortedProjects.slice(0, 4).map((project) => {
                  const yearLabel =
                    project.status === "work_in_progress"
                      ? null
                      : project.year_completed || "Present";

                  const trailingLabel =
                    project.status === "work_in_progress" ? (
                      <AnimatedGradientText text="WIP" />
                    ) : (
                      <span class="text-muted-foreground">{yearLabel}</span>
                    );

                  if (project.link && project.status !== "work_in_progress") {
                    return (
                      <a
                        class="flex min-w-0 justify-between gap-4 px-1 hover:bg-muted"
                        href={project.link}
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        <span class="min-w-0 line-clamp-1">{project.name}</span>
                        {trailingLabel}
                      </a>
                    );
                  }

                  return (
                    <div class="flex min-w-0 justify-between gap-4 px-1">
                      <span class="min-w-0 line-clamp-1">{project.name}</span>
                      {trailingLabel}
                    </div>
                  );
                })}
              </div>
            </div>
            <div class="flex justify-end">
              <a
                class="text-sm text-muted-foreground px-1 hover:bg-muted"
                href="/projects"
              >
                See all {projects.length} projects
              </a>
            </div>
          </div>
        </div>

        <hr class="border-dotted border-border" />

        {
          githubContributions ? (
            <ContributionsGraphStatic contributions={githubContributions} />
          ) : (
            <GitHubContributions
              client:visible
              username={githubUsername}
            />
          )
        }

        <hr class="border-dotted border-border" />

        <div class="flex min-w-0 flex-col gap-2">
          <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <BrisbaneDateTime />
            <div class="flex min-w-0 items-center justify-end gap-4">
              <LocationStatus initial={initialLocation} />
              <LanyardStatus />
            </div>
          </div>
          <LanyardListening />
          <div class="flex min-w-0 justify-between gap-4">
            <div class="-ml-1 flex min-w-0 flex-row flex-wrap gap-2 text-sm text-muted-foreground">
              <a class="inline-flex px-1 hover:bg-muted" href="/colophon">
                Colophon
              </a>
              <span>•</span>
              <a class="inline-flex px-1 hover:bg-muted" href="/imprint">
                Imprint
              </a>
            </div>

            <ToggleTheme />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
