---
import UsesPage from "@/components/uses-page";
import Layout from "@/layouts/layout.astro";
import { getUses } from "@/lib/directus-content";
import { createPageMetadata, formatPageTitle } from "@/lib/metadata";
import { buildUsesSections } from "@/lib/uses-sections";

const uses = await getUses();
const sections = buildUsesSections(uses);

const pageMeta = createPageMetadata({
  description: "A collection of tools, apps, and hardware I use every day.",
  path: "/uses",
  title: "Uses",
});

const fullTitle = formatPageTitle("Uses");
---

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  <UsesPage client:idle sections={sections} />
</Layout>
