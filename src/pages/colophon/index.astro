---
import CarbonBadge from "@/components/carbon-badge.astro";
import ColophonPage from "@/components/colophon-page";
import Layout from "@/layouts/layout.astro";
import { createPageMetadata, formatPageTitle } from "@/lib/metadata";

const pageMeta = createPageMetadata({
  description:
    "How zacchary.me is built: Astro on Cloudflare Workers, with content from Directus. Typography, tools, and inspiration behind the site.",
  path: "/colophon",
  title: "How this site is built",
});

const fullTitle = formatPageTitle("How this site is built");
---

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  <ColophonPage />
  <CarbonBadge />
</Layout>
