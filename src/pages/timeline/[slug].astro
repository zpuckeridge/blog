---
import GoneContent from "@/components/gone-content";
import NotFoundContent from "@/components/not-found-content";
import Subscribe from "@/components/subscribe";
import TimelinePost from "@/components/timeline-post";
import Layout from "@/layouts/layout.astro";
import { collectContentAssetIds } from "@/lib/content-image";
import type { ContentImageMeta } from "@/lib/content-image";
import {
  getDirectusFileMeta,
  getPostBySlug,
  getPosts,
} from "@/lib/directus-content";
import {
  CONTENT_IMAGE_SIZES,
  directusHeroLcpPreload,
} from "@/lib/directus-asset";
import {
  buildMetadataUrl,
  buildTimelinePostMetadata,
  createPageMetadata,
  formatPageTitle,
} from "@/lib/metadata";
import { relatedPostLinks } from "@/lib/related-posts";
import {
  filterPostsForPublicSite,
  isRemovedTimelinePostSlug,
  timelinePermanentRedirect,
} from "@/lib/removed-timeline";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const redirectTarget = timelinePermanentRedirect(`/timeline/${slug}`);
if (redirectTarget) {
  return Astro.redirect(redirectTarget, 301);
}

const removed = isRemovedTimelinePostSlug(slug);

const post = removed ? null : await getPostBySlug(slug);

if (!post && !removed) {
  Astro.response.status = 404;
}

if (removed) {
  Astro.response.status = 410;
}

const allPosts = post ? filterPostsForPublicSite(await getPosts()) : [];
const related = post ? relatedPostLinks(post, allPosts) : [];
const files = post
  ? await getDirectusFileMeta(
      collectContentAssetIds(post.content ?? "", post.image)
    )
  : [];
const imageMeta: Record<string, ContentImageMeta> = {};
for (const file of files) {
  imageMeta[file.id] = {
    description: file.description,
    title: file.title,
  };
}

const pageMeta = post
  ? buildTimelinePostMetadata(post, slug)
  : createPageMetadata({
      description: removed
        ? "This content has been permanently removed."
        : "Page could not be found.",
      image: {
        alt: removed ? "410 — Gone" : "404 — Not Found",
        url: buildMetadataUrl("/media/404.webp"),
      },
      noIndex: true,
      title: removed ? "410 — Gone" : "404 — Not Found",
    });

const fullTitle = post
  ? formatPageTitle(post.title)
  : formatPageTitle(removed ? "410 — Gone" : "404 — Not Found");

const heroLcpPreload = post?.image
  ? directusHeroLcpPreload(post.image)
  : undefined;
---

<Layout
  canonicalUrl={pageMeta?.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  {
    heroLcpPreload ? (
      <link
        as="image"
        fetchpriority="high"
        href={heroLcpPreload.avifHref}
        imagesizes={CONTENT_IMAGE_SIZES}
        imagesrcset={heroLcpPreload.avifSrcSet}
        rel="preload"
        slot="head"
        type="image/avif"
      />
    ) : null
  }
  {
    post ? (
      <TimelinePost
        client:idle
        imageMeta={imageMeta}
        post={post}
        related={related}
        slug={slug}
      >
        <Subscribe client:visible />
      </TimelinePost>
    ) : removed ? (
      <GoneContent />
    ) : (
      <NotFoundContent />
    )
  }
  <script>
    import { initPostEnhancements } from "@/scripts/post-enhancements";

    initPostEnhancements();
    document.addEventListener("astro:page-load", () => {
      initPostEnhancements();
    });
  </script>
</Layout>
