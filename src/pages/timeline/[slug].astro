---
import NotFoundContent from "@/components/not-found-content";
import PasswordProtection from "@/components/password-protection";
import TimelinePost from "@/components/timeline-post";
import { Toaster } from "@/components/ui/sonner";
import Layout from "@/layouts/layout.astro";
import {
  buildMetadataUrl,
  buildTimelinePostMetadata,
  createPageMetadata,
  formatPageTitle,
} from "@/lib/metadata";
import { getPostBySlug } from "@/lib/directus-content";
import {
  getVideoAccessErrorMessage,
  getVideoAuthCookieName,
  getVideoPassword,
  isVideoAuthTokenValid,
} from "@/lib/video-auth";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const post = await getPostBySlug(slug);

if (!post) {
  Astro.response.status = 404;
}

const { searchParams } = Astro.url;
const cookie = Astro.cookies.get(getVideoAuthCookieName())?.value;
const videoPassword = getVideoPassword();
const isAuthenticated = await isVideoAuthTokenValid(cookie, videoPassword);

const pageMeta = post
  ? {
      ...buildTimelinePostMetadata(post, slug),
      robots: {
        follow: false,
        index: false,
      },
    }
  : createPageMetadata({
      description: "Page could not be found.",
      image: {
        alt: "404 — Not Found",
        url: buildMetadataUrl("/media/404.webp"),
      },
      noIndex: true,
      title: "404 — Not Found",
    });

const fullTitle = post
  ? formatPageTitle(post.title)
  : formatPageTitle("404 — Not Found");
---

<Layout
  canonicalUrl={pageMeta?.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  {
    !post ? (
      <NotFoundContent />
    ) : !isAuthenticated ? (
      <PasswordProtection
        description="Please enter the password to view this post."
        error={getVideoAccessErrorMessage(searchParams.get("error"))}
        isConfigured={Boolean(videoPassword)}
        redirectTo={`/timeline/${slug}`}
        title="Timeline"
      />
    ) : (
      <TimelinePost client:idle post={post} slug={slug} />
    )
  }
  <Toaster client:idle position="top-center" richColors />
</Layout>
