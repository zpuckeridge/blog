---
import NotFoundContent from "@/components/not-found-content";
import Subscribe from "@/components/subscribe";
import TimelinePost from "@/components/timeline-post";
import Layout from "@/layouts/layout.astro";
import { collectContentAssetIds } from "@/lib/content-image";
import type { ContentImageMeta } from "@/lib/content-image";
import {
  getDirectusFileMeta,
  getPostBySlug,
  getPosts,
} from "@/lib/directus-content";
import {
  buildMetadataUrl,
  buildTimelinePostMetadata,
  createPageMetadata,
  formatPageTitle,
} from "@/lib/metadata";
import { relatedPostLinks } from "@/lib/related-posts";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const post = await getPostBySlug(slug);

if (!post) {
  Astro.response.status = 404;
}

const allPosts = post ? await getPosts() : [];
const related = post ? relatedPostLinks(post, allPosts) : [];
const files = post
  ? await getDirectusFileMeta(
      collectContentAssetIds(post.content ?? "", post.image)
    )
  : [];
const imageMeta: Record<string, ContentImageMeta> = {};
for (const file of files) {
  imageMeta[file.id] = {
    description: file.description,
    title: file.title,
  };
}

const pageMeta = post
  ? buildTimelinePostMetadata(post, slug)
  : createPageMetadata({
      description: "Page could not be found.",
      image: {
        alt: "404 — Not Found",
        url: buildMetadataUrl("/media/404.webp"),
      },
      noIndex: true,
      title: "404 — Not Found",
    });

const fullTitle = post
  ? formatPageTitle(post.title)
  : formatPageTitle("404 — Not Found");
---

<Layout
  canonicalUrl={pageMeta?.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  {
    post ? (
      <TimelinePost
        imageMeta={imageMeta}
        post={post}
        related={related}
        slug={slug}
      >
        <Subscribe client:visible />
      </TimelinePost>
    ) : (
      <NotFoundContent />
    )
  }
  <script>
    import { initPostEnhancements } from "@/scripts/post-enhancements";

    initPostEnhancements();
    document.addEventListener("astro:page-load", () => {
      initPostEnhancements();
    });
  </script>
</Layout>
