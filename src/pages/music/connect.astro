---
import AppleMusicConnect from "@/components/apple-music-connect";
import Layout from "@/layouts/layout.astro";
import { createAppleMusicDeveloperToken } from "@/lib/apple-music-developer-token";
import { createPageMetadata, formatPageTitle } from "@/lib/metadata";
import { workersEnv } from "@/lib/workers-env";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const developerToken = await createAppleMusicDeveloperToken(workersEnv);

const pageMeta = createPageMetadata({
  description: "Private Apple Music connection for listening history.",
  noIndex: true,
  path: "/music/connect",
  title: "Connect Apple Music",
});

const fullTitle = formatPageTitle("Connect Apple Music");
---

<script
  defer
  src="https://js-cdn.music.apple.com/musickit/v3/musickit.js"
></script>

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
  title="Connect Apple Music"
>
  <main class="mx-auto max-w-lg px-4 py-16">
    <h1 class="font-redaction mb-6 text-2xl text-black dark:text-white">
      Connect Apple Music
    </h1>
    {
      developerToken ? (
        <AppleMusicConnect client:load developerToken={developerToken} />
      ) : (
        <p class="text-muted-foreground text-sm">
          Apple Music signing secrets are not configured on this environment.
        </p>
      )
    }
  </main>
</Layout>