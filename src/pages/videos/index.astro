---
import Videos from "@/components/videos";
import Layout from "@/layouts/layout.astro";
import { compareDesc } from "date-fns";
import { backLinkClassName } from "@/components/back-link";
import { createPageMetadata, formatPageTitle } from "@/lib/metadata";
import { getVideos } from "@/lib/directus-content";

export const prerender = false;

const pageMeta = createPageMetadata({
  description:
    "A compilation of humorous, thrilling, and memorable moments from my life and some of the video games I regularly play—with occasional questionable decisions.",
  path: "/videos",
  title: "Videos",
});

const fullTitle = formatPageTitle("Videos");

const videos = await getVideos();

const sortedVideos = videos.toSorted((a, b) =>
  compareDesc(new Date(a.date_created), new Date(b.date_created))
);
---

<Layout
  canonicalUrl={pageMeta.alternates?.canonical}
  fullTitle={fullTitle}
  meta={pageMeta}
>
  <div class="mx-auto flex max-w-lg flex-col gap-4 px-6 pb-20">
        <div class="flex flex-col gap-y-20 text-sm">
          <div class="space-y-10">
            <div class="space-y-2">
              <h1 class="font-redaction text-black text-xl dark:text-white">
                Videos
              </h1>

              <p>
                A compilation of humorous, thrilling, and memorable moments from
                my life and some of the video games I regularly play—with
                occasional questionable decisions.
              </p>
            </div>

            <div class="space-y-10">
              <hr class="border-dotted border-border" />

              <Videos client:idle itemsPerPage={6} videos={sortedVideos} />
            </div>
          </div>

          <a aria-label="Back to home" class={backLinkClassName} href="/">
            ../
          </a>
        </div>
  </div>
</Layout>
