{
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "workers_dev": true,

  "triggers": {
    "crons": ["* * * * *"],
  },

  "routes": [{ "pattern": "zacchary.me", "custom_domain": true }],

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler"],
    },
  ],

  "vars": {
    "PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "PUBLIC_POSTHOG_KEY": "phc_rGomIwYYw8WCXt3qHwnevbXKMtSXtM78xxbMfOdCXdy",
  },

  "placement": {
    "mode": "smart",
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },

  "images": {
    "binding": "IMAGES",
  },

  "kv_namespaces": [
    {
      "binding": "LOCATION_KV",
      "id": "c94fa5efd59d417c8f5ea2ecf2972730",
      "preview_id": "c26add25eee24e32a68f067f4c19c81c",
    },
  ],
}
